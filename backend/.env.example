FLASK_APP=app.py

DB_ENGINE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=usuario_app
DB_PASSWORD=CAMBIAR
DB_NAME=gestion_entrenamiento_v2

SECRET_KEY=CAMBIAR
SESSION_COOKIE_NAME=my_session_v2
SESSION_COOKIE_SECURE=false
MAX_CONTENT_LENGTH=5242880

CORS_ORIGINS=http://127.0.0.1:5002,http://localhost:5002

WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Token propio (inventado por nosotros) que se configura también en Meta App
# Dashboard > WhatsApp > Configuration al dar de alta el webhook. Meta lo
# reenvía en la verificación GET y solo respondemos si coincide.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret de la app de Meta (Configuración básica de la app). Se usa para
# comprobar la firma X-Hub-Signature-256 de cada evento del webhook y
# descartar peticiones que no vengan realmente de Meta.
WHATSAPP_APP_SECRET=

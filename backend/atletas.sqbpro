n index="10" value="95"/><column index="11" value="179"/><column index="12" value="60"/><column index="13" value="45"/><column index="14" value="154"/><column index="15" value="154"/><column index="16" value="97"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="km_realizados_entrenamientos" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="4" mode="0"/></sort><column_widths><column index="1" value="24"/><column index="2" value="191"/><column index="3" value="116"/><column index="4" value="103"/><column index="5" value="68"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT
  strftime('%Y-%W', date(COALESCE(kre.fecha, ea.fecha))) AS semana,
  SUM(COALESCE(kre.km_realizados, 0)) AS km_realizados
FROM km_realizados_entrenamientos kre
JOIN entrenamientos_asignados ea
  ON ea.id = kre.entrenamiento_asignado_id
WHERE ea.atleta_id = 3
GROUP BY semana
ORDER BY semana;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
